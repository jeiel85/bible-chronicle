{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bible-chronicle/schemas/event.schema.json",
  "title": "Bible Chronicle Canonical Event v1",
  "description": "Canonical history is immutable; user choices can only change observation/learning context.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","eventType","titleKo","scriptureRefs","historicalClaimIds","date","placeIds","canonicalOutcomeId","canonicalNextEventIds","synopsisKo","representation","factcheckStatus","contentStatus","scenes"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},
    "eventType": {"enum":["canonical_narrative","external_historical_event","literary_context"]},
    "titleKo": {"type":"string","minLength":1},
    "scriptureRefs": {"type":"array","items":{"$ref":"#/$defs/passage"}},
    "historicalClaimIds": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "date": {"oneOf":[{"$ref":"#/$defs/exactYear"},{"$ref":"#/$defs/yearRange"},{"$ref":"#/$defs/unknownYear"}]},
    "placeIds": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "canonicalOutcomeId": {"type":"string","minLength":1},
    "canonicalNextEventIds": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "synopsisKo": {"type":"string","minLength":1},
    "representation": {"enum":["biblical_record","biblical_and_external_sources","literary_context","external_only"]},
    "factcheckStatus": {"enum":["unverified","source_checked_scope_limited","scholarly_debate","not_applicable"]},
    "contentStatus": {"enum":["demonstration_not_publishable","draft","in_review","published"]},
    "scenes": {"type":"array","items":{"$ref":"#/$defs/scene"}}
  },
  "allOf":[
    {"if":{"properties":{"eventType":{"const":"canonical_narrative"}}},"then":{"properties":{"scriptureRefs":{"minItems":1}}}},
    {"if":{"properties":{"eventType":{"const":"external_historical_event"}}},"then":{"properties":{"historicalClaimIds":{"minItems":1}}}}
  ],
  "$defs": {
    "passage":{"type":"object","additionalProperties":false,"required":["bookId","chapterStart","chapterEnd"],"properties":{"bookId":{"type":"string","minLength":2},"chapterStart":{"type":"integer","minimum":1},"chapterEnd":{"type":"integer","minimum":1},"verseStart":{"type":"integer","minimum":1},"verseEnd":{"type":"integer","minimum":1}}},
    "exactYear":{"type":"object","additionalProperties":false,"required":["kind","yearAstronomical","displayLabel","sourceIds"],"properties":{"kind":{"const":"exactYear"},"yearAstronomical":{"type":"integer"},"displayLabel":{"type":"string","minLength":1},"sourceIds":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "yearRange":{"type":"object","additionalProperties":false,"required":["kind","startYearAstronomical","endYearAstronomical","displayLabel","sourceIds"],"properties":{"kind":{"const":"range"},"startYearAstronomical":{"type":"integer"},"endYearAstronomical":{"type":"integer"},"displayLabel":{"type":"string","minLength":1},"sourceIds":{"type":"array","items":{"type":"string"}}}},
    "unknownYear":{"type":"object","additionalProperties":false,"required":["kind","displayLabel","sourceIds"],"properties":{"kind":{"const":"unknown"},"displayLabel":{"const":"연대 미확정"},"sourceIds":{"type":"array","maxItems":0}}},
    "scene":{"type":"object","additionalProperties":false,"required":["id","type","imageAssetId","disclosureKo","choices"],"properties":{"id":{"type":"string","minLength":1},"type":{"enum":["scripture_reading","historical_reconstruction","evidence_comparison","literary_reflection"]},"imageAssetId":{"type":["string","null"]},"disclosureKo":{"type":"string"},"choices":{"type":"array","items":{"$ref":"#/$defs/choice"}}}},
    "choice":{"type":"object","additionalProperties":false,"required":["id","labelKo","inspectionTags","nextSceneId"],"properties":{"id":{"type":"string","minLength":1},"labelKo":{"type":"string","minLength":1},"inspectionTags":{"type":"array","items":{"type":"string"}},"nextSceneId":{"type":"string","minLength":1},"reflectionPrompt":{"type":"string"},"screenFocus":{"enum":["image","map","evidence","scripture"]}}}
  }
}
